## Demo of YAML 1.2 parsing and serialization
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as yaml

function main()
    say "=================================================="
    say "        Alya YAML 1.2 Parser & Serializer Demo    "
    say "=================================================="

    # 1. Parsing a Docker Compose style YAML configuration
    let compose_yaml = "version: '3.8'\n"
    compose_yaml += "services:\n"
    compose_yaml += "  web:\n"
    compose_yaml += "    image: nginx:alpine\n"
    compose_yaml += "    ports:\n"
    compose_yaml += "      - 80:80\n"
    compose_yaml += "      - 443:443\n"
    compose_yaml += "    restart: always\n"
    compose_yaml += "  api:\n"
    compose_yaml += "    image: alya-backend:latest\n"
    compose_yaml += "    environment:\n"
    compose_yaml += "      ENV: production\n"
    compose_yaml += "      PORT: 8080\n"
    compose_yaml += "      ENABLE_METRICS: true\n"
    compose_yaml += "    tags: [ 'backend', 'api', 'v1' ]\n"

    say "\n1. Parsing Docker Compose YAML:"
    let config = yaml::parse(compose_yaml)
    let compose_ver = str(config["version"])
    let web_image = str(config["services"]["web"]["image"])
    let web_restart = str(config["services"]["web"]["restart"])
    let api_port = config["services"]["api"]["environment"]["PORT"]
    let api_metrics = config["services"]["api"]["environment"]["ENABLE_METRICS"]
    say "  Compose Version : {compose_ver}"
    say "  Web Image       : {web_image}"
    say "  Web Restart     : {web_restart}"
    say "  API Port        : {api_port}"
    say "  API Metrics     : {api_metrics}"

    let web_ports = config["services"]["web"]["ports"]
    let web_port_count = len(web_ports)
    say "  Web Ports Count : {web_port_count}"
    for port in web_ports
        let port_str = str(port)
        say "    - {port_str}"
    end

    let api_tags = config["services"]["api"]["tags"]
    let tag0 = str(api_tags[0])
    let tag1 = str(api_tags[1])
    let tag2 = str(api_tags[2])
    say "  API Flow Tags   : {tag0}, {tag1}, {tag2}"

    # 2. Serializing native Alya data to YAML
    say "\n2. Serializing Native Alya Data to YAML:"
    let deployment = {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
            "name": "alya-service",
            "labels": {
                "tier": "production"
            }
        },
        "spec": {
            "replicas": 3,
            "containers": [
                {
                    "name": "core-engine",
                    "image": "alya-lang/core:v0.1.0",
                    "resources": {
                        "cpu": "500m",
                        "memory": "256Mi"
                    }
                }
            ]
        }
    }

    let serialized = yaml::stringify(deployment, 2)
    say serialized
end

main()
