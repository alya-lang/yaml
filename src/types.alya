## # yaml/types
##
## YAML 1.2 data types and definitions.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Defines node type discriminators, the document container, runtime shape
## inspection, and string and character utilities.

## YAML node type discriminators.
pub enum YamlNodeType
    Null = 0,
    Bool = 1,
    Int = 2,
    Float = 3,
    String = 4,
    Array = 5,
    Map = 6
end

## Document container struct.
##
## ### Fields
## - `doc_data`: Parsed document payload (map, array, or scalar).
pub struct YamlDoc
    doc_data
end

## Returns the document payload.
##
## ### Parameters
## - `self`: The target `YamlDoc` instance.
##
## ### Returns
## The document payload value.
pub function YamlDoc.get(self: YamlDoc)
    return self.doc_data
end

## Alias for `get`, returning the document payload.
##
## ### Parameters
## - `self`: The target `YamlDoc` instance.
##
## ### Returns
## The document payload value.
pub function YamlDoc.data(self: YamlDoc)
    return self.doc_data
end

## Factory constructor wrapping data into a `YamlDoc`.
##
## ### Parameters
## - `data`: Document payload value.
##
## ### Returns
## The new `YamlDoc` instance.
pub function make_doc(data) -> YamlDoc
    return YamlDoc {
        doc_data: data
    }
end

# ───────────────────────────────────────────────────────────────
# Memory & Runtime Pointer Inspection
# ───────────────────────────────────────────────────────────────

## Checks whether a value looks like a heap pointer.
##
## ### Parameters
## - `v`: Value to inspect.
##
## ### Returns
## `1` for plausible heap addresses, `0` otherwise.
pub function is_heap_pointer(v) -> int
    if v is null or v == 0
        return false
    end
    if v < 65536
        return false
    end
    if v > 140737488355327
        return false
    end
    return true
end

## Checks whether a value is a list object.
##
## ### Parameters
## - `v`: Value to inspect.
##
## ### Returns
## `1` for lists, `0` otherwise.
pub function is_list(v) -> int
    if v is array
        return true
    end
    return false
end

## Checks whether a value is a map object.
##
## ### Parameters
## - `v`: Value to inspect.
##
## ### Returns
## `1` for maps, `0` otherwise.
pub function is_map_obj(v) -> int
    if v is map
        return true
    end
    return false
end

# ───────────────────────────────────────────────────────────────
# String Utility Functions
# ───────────────────────────────────────────────────────────────

## Checks whether a string starts with a prefix.
##
## ### Parameters
## - `s`: Haystack string.
## - `prefix`: Prefix string.
##
## ### Returns
## `1` on prefix match, `0` otherwise.
pub function yaml_str_starts_with(s: string, prefix: string) -> int
    let plen = len(prefix)
    let slen = len(s)
    if plen > slen
        return false
    end
    if plen == 0
        return true
    end
    return s[0..plen] == prefix
end

## Checks whether a string ends with a suffix.
##
## ### Parameters
## - `s`: Haystack string.
## - `suffix`: Suffix string.
##
## ### Returns
## `1` on suffix match, `0` otherwise.
pub function yaml_str_ends_with(s: string, suffix: string) -> int
    let suflen = len(suffix)
    let slen = len(s)
    if suflen > slen
        return false
    end
    if suflen == 0
        return true
    end
    return s[slen - suflen..slen] == suffix
end

## Replaces every occurrence of a substring.
##
## ### Parameters
## - `s`: Source string.
## - `old_sub`: Needle substring (empty needles return the source).
## - `new_sub`: Replacement substring.
##
## ### Returns
## The replaced string.
pub function yaml_str_replace(s: string, old_sub: string, new_sub: string) -> string
    let slen = len(s)
    let olen = len(old_sub)
    if olen == 0 or slen == 0
        return s
    end
    let res = ""
    let i = 0
    while i < slen
        if i + olen <= slen and s[i..i + olen] == old_sub
            res += new_sub
            i += olen
        else
            res += char_at(s, i)
            i += 1
        end
    end
    return res
end

# ───────────────────────────────────────────────────────────────
# Character Classification
# ───────────────────────────────────────────────────────────────

# Checks if a character is a hexadecimal digit.
function yaml_is_hex_digit(ch: string) -> int
    let c = ord(ch)
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
end

# Checks if a character is an octal digit.
function yaml_is_oct_digit(ch: string) -> int
    let c = ord(ch)
    return c >= 48 and c <= 55
end

# Checks if a character is a binary digit.
function yaml_is_bin_digit(ch: string) -> int
    let c = ord(ch)
    return c == 48 or c == 49
end

## Checks whether a map contains a key.
##
## ### Parameters
## - `m`: Target map value.
## - `key`: Key string.
##
## ### Returns
## `1` when the key exists, `0` otherwise.
pub function map_has_key(m, key: string) -> int
    if is_map_obj(m) == false
        return false
    end
    return key in m
end
