# YAML 1.2 Flow Style (Inline Collections) Parser
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"
import "./scalar.alya"

# Helper to skip whitespace in flow string
pub function flow_skip_ws(s, pos, slen)
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
            pos[0] += 1
        else
            break
        end
    end
end

# Parses a single-quoted string in flow style
pub function flow_parse_single_quote(s, pos, slen)
    pos[0] += 1
    let res = ""
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == "'"
            if pos[0] + 1 < slen and char_at(s, pos[0] + 1) == "'"
                res += "'"
                pos[0] += 2
            else
                pos[0] += 1
                break
            end
        else
            res += ch
            pos[0] += 1
        end
    end
    return res
end

# Parses a double-quoted string in flow style
pub function flow_parse_double_quote(s, pos, slen)
    pos[0] += 1
    let raw = ""
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == "\""
            pos[0] += 1
            break
        elif ch == "\\"
            if pos[0] + 1 < slen
                raw += "\\" + char_at(s, pos[0] + 1)
                pos[0] += 2
            else
                raw += "\\"
                pos[0] += 1
            end
        else
            raw += ch
            pos[0] += 1
        end
    end
    return unescape_double_quoted(raw)
end

# Parses an unquoted scalar in flow style up to a delimiter (, or ] or } or :)
pub function flow_parse_plain(s, pos, slen, stop_on_colon = 0)
    let start = pos[0]
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == "," or ch == "]" or ch == "}"
            break
        end
        if stop_on_colon == 1 and ch == ":"
            break
        end
        pos[0] += 1
    end
    let sub = s[start..pos[0]].trim()
    return parse_scalar(sub)
end

# Parses an inline flow sequence: [ item1, item2, ... ]
pub function flow_parse_sequence(s, pos, slen)
    pos[0] += 1
    let arr = []
    flow_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "]"
        pos[0] += 1
        return arr
    end

    while pos[0] < slen
        flow_skip_ws(s, pos, slen)
        if pos[0] >= slen or char_at(s, pos[0]) == "]"
            if pos[0] < slen
                pos[0] += 1
            end
            break
        end

        let val = flow_parse_value(s, pos, slen)
        arr.push(val)

        flow_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ","
            pos[0] += 1
        elif pos[0] < slen and char_at(s, pos[0]) == "]"
            pos[0] += 1
            break
        else
            break
        end
    end
    return arr
end

# Parses an inline flow mapping: { key1: val1, key2: val2, ... }
pub function flow_parse_mapping(s, pos, slen)
    pos[0] += 1
    let m = {}
    flow_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "}"
        pos[0] += 1
        return m
    end

    while pos[0] < slen
        flow_skip_ws(s, pos, slen)
        if pos[0] >= slen or char_at(s, pos[0]) == "}"
            if pos[0] < slen
                pos[0] += 1
            end
            break
        end

        # Parse key
        let key_str = ""
        let ch = char_at(s, pos[0])
        when ch
            is "'"  then key_str = flow_parse_single_quote(s, pos, slen)
            is "\"" then key_str = flow_parse_double_quote(s, pos, slen)
            else
                let raw_k = flow_parse_plain(s, pos, slen, 1)
                key_str = str(raw_k)
        end

        flow_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ":"
            pos[0] += 1
        end

        # Parse value
        let val = flow_parse_value(s, pos, slen)
        m[key_str] = val

        flow_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ","
            pos[0] += 1
        elif pos[0] < slen and char_at(s, pos[0]) == "}"
            pos[0] += 1
            break
        else
            break
        end
    end
    return m
end

# Forward declaration helper
pub function flow_parse_value(s, pos, slen)
    flow_skip_ws(s, pos, slen)
    if pos[0] >= slen
        return null
    end
    let ch = char_at(s, pos[0])
    when ch
        is "["  then return flow_parse_sequence(s, pos, slen)
        is "{"  then return flow_parse_mapping(s, pos, slen)
        is "'"  then return flow_parse_single_quote(s, pos, slen)
        is "\"" then return flow_parse_double_quote(s, pos, slen)
        else         return flow_parse_plain(s, pos, slen, 0)
    end
end

# Public convenience helper to parse a flow string
pub function parse_flow(s)
    let pos = [0]
    let slen = len(s)
    return flow_parse_value(s, pos, slen)
end
