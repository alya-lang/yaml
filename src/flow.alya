## # yaml/flow
##
## YAML 1.2 flow style (inline collections) parser.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Parses inline sequences (`[a, b]`), mappings (`{k: v}`), quoted strings,
## and plain scalars using a shared cursor protocol.

import "./scalar.alya"

## Skips whitespace inside a flow string via the shared cursor.
##
## ### Parameters
## - `s`: Source string.
## - `pos`: Single-element cursor array (mutated in place).
## - `slen`: Total source length.
pub function flow_skip_ws(s: string, pos: array, slen: int)
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
            pos[0] += 1
        else
            break
        end
    end
end

## Parses a single-quoted string in flow style (`''` escapes a quote).
##
## ### Parameters
## - `s`: Source string.
## - `pos`: Single-element cursor array (mutated in place).
## - `slen`: Total source length.
##
## ### Returns
## The parsed string value.
pub function flow_parse_single_quote(s: string, pos: array, slen: int) -> string
    pos[0] += 1
    let res = ""
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == "'"
            if pos[0] + 1 < slen and char_at(s, pos[0] + 1) == "'"
                res += "'"
                pos[0] += 2
            else
                pos[0] += 1
                break
            end
        else
            res += ch
            pos[0] += 1
        end
    end
    return res
end

## Parses a double-quoted string in flow style with standard escapes.
##
## ### Parameters
## - `s`: Source string.
## - `pos`: Single-element cursor array (mutated in place).
## - `slen`: Total source length.
##
## ### Returns
## The unescaped string value.
pub function flow_parse_double_quote(s: string, pos: array, slen: int) -> string
    pos[0] += 1
    let raw = ""
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == "\""
            pos[0] += 1
            break
        elif ch == "\\"
            if pos[0] + 1 < slen
                let esc_ch = char_at(s, pos[0] + 1)
                raw += "\\{esc_ch}"
                pos[0] += 2
            else
                raw += "\\"
                pos[0] += 1
            end
        else
            raw += ch
            pos[0] += 1
        end
    end
    return unescape_double_quoted(raw)
end

## Parses an unquoted scalar up to a delimiter (`,`, `]`, `}`, or `:`).
##
## ### Parameters
## - `s`: Source string.
## - `pos`: Single-element cursor array (mutated in place).
## - `slen`: Total source length.
## - `stop_on_colon`: `1` also stops at `:`. Defaults to `0`.
##
## ### Returns
## The typed scalar value.
pub function flow_parse_plain(s: string, pos: array, slen: int, stop_on_colon: int = 0)
    let start = pos[0]
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == "," or ch == "]" or ch == "}"
            break
        end
        if stop_on_colon == 1 and ch == ":"
            break
        end
        pos[0] += 1
    end
    let sub = s[start..pos[0]].trim()
    return parse_scalar(sub)
end

## Parses an inline flow sequence (`[ item1, item2, ... ]`).
##
## ### Parameters
## - `s`: Source string.
## - `pos`: Single-element cursor array (mutated in place).
## - `slen`: Total source length.
##
## ### Returns
## The parsed element array.
pub function flow_parse_sequence(s: string, pos: array, slen: int) -> array
    pos[0] += 1
    let arr = []
    flow_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "]"
        pos[0] += 1
        return arr
    end

    while pos[0] < slen
        flow_skip_ws(s, pos, slen)
        if pos[0] >= slen or char_at(s, pos[0]) == "]"
            if pos[0] < slen
                pos[0] += 1
            end
            break
        end

        let val = flow_parse_value(s, pos, slen)
        arr.push(val)

        flow_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ","
            pos[0] += 1
        elif pos[0] < slen and char_at(s, pos[0]) == "]"
            pos[0] += 1
            break
        else
            break
        end
    end
    return arr
end

## Parses an inline flow mapping (`{ key1: val1, ... }`).
##
## ### Parameters
## - `s`: Source string.
## - `pos`: Single-element cursor array (mutated in place).
## - `slen`: Total source length.
##
## ### Returns
## The parsed entry map.
pub function flow_parse_mapping(s: string, pos: array, slen: int)
    pos[0] += 1
    let m = {}
    flow_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "}"
        pos[0] += 1
        return m
    end

    while pos[0] < slen
        flow_skip_ws(s, pos, slen)
        if pos[0] >= slen or char_at(s, pos[0]) == "}"
            if pos[0] < slen
                pos[0] += 1
            end
            break
        end

        # Parse key
        let key_str = ""
        let ch = char_at(s, pos[0])
        when ch
            is "'"  then key_str = flow_parse_single_quote(s, pos, slen)
            is "\"" then key_str = flow_parse_double_quote(s, pos, slen)
            else
                let raw_k = flow_parse_plain(s, pos, slen, 1)
                key_str = str(raw_k)
        end

        flow_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ":"
            pos[0] += 1
        end

        # Parse value
        let val = flow_parse_value(s, pos, slen)
        m[key_str] = val

        flow_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ","
            pos[0] += 1
        elif pos[0] < slen and char_at(s, pos[0]) == "}"
            pos[0] += 1
            break
        else
            break
        end
    end
    return m
end

## Dispatches one flow value by its leading character.
##
## ### Parameters
## - `s`: Source string.
## - `pos`: Single-element cursor array (mutated in place).
## - `slen`: Total source length.
##
## ### Returns
## The parsed value.
pub function flow_parse_value(s: string, pos: array, slen: int)
    flow_skip_ws(s, pos, slen)
    if pos[0] >= slen
        return null
    end
    let ch = char_at(s, pos[0])
    when ch
        is "["  then return flow_parse_sequence(s, pos, slen)
        is "{"  then return flow_parse_mapping(s, pos, slen)
        is "'"  then return flow_parse_single_quote(s, pos, slen)
        is "\"" then return flow_parse_double_quote(s, pos, slen)
        else         return flow_parse_plain(s, pos, slen, 0)
    end
end

## Parses a complete flow string into a native value.
##
## ### Parameters
## - `s`: Flow source string.
##
## ### Returns
## The parsed value.
##
## ### Examples
## ```alya
## let arr = parse_flow("[1, 2]")
## ```
pub function parse_flow(s: string)
    let pos = [0]
    let slen = len(s)
    return flow_parse_value(s, pos, slen)
end
